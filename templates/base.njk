<!DOCTYPE html>
<html lang="{{ lang or (blog == 'disco' and 'es' or 'ca') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="../../../favicon_io/favicon.ico">
    <title>{{ title }} - El Árbol de las Flores Negras</title>
    <meta name="description" content="{{ description or '' }}">
    <script>!function(){var t=localStorage.getItem('theme-preference');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');else if(t==='light')document.documentElement.setAttribute('data-theme','light');else if(window.matchMedia('(prefers-color-scheme:dark)').matches)document.documentElement.setAttribute('data-theme','dark')}();</script>
    <link rel="stylesheet" href="../../../assets/css/style.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet"></noscript>
</head>
<body class="blog-page">

    <nav class="navbar">
        <div class="nav-container">
            <div class="nav-links">
                {% if blog %}
                <a href="../../{{ blog }}">← Volver al blog</a>
                {% endif %}
            </div>
            <button id="theme-toggle" class="theme-toggle" aria-label="Tema: Auto" title="Tema: Auto (clic para cambiar)"></button>
            <span id="theme-label" class="theme-label">Auto</span>
        </div>
    </nav>

    <main>
    {{ content | safe }}
    </main>

    <footer>
        <div class="container">
            <p>© <span id="current-year"></span> Marc Ramos Bruach</p>
        </div>
    </footer>

    <script>if('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js').catch(()=>{})}</script>
    <script src="../../../assets/js/theme.js" defer></script>
    <script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('current-year');e&&(e.textContent=new Date().getFullYear())});</script>
</body>
</html>
